[Unit]
Description=ComfyUI
After=network.target
Wants=comfyui-resource-watch.service

[Service]
Type=simple
WorkingDirectory=@RELEASES_ROOT@/current
# Defaults are local-only; @SECRETS_FILE@ overrides them (see templates/comfy.example).
Environment=COMFY_LISTEN_ADDR=127.0.0.1
Environment=COMFY_PORT=8188
Environment=COMFY_EXTRA_MODEL_PATHS=%h/.config/comfyui/extra_model_paths.yaml
EnvironmentFile=-@SECRETS_FILE@
# Advisory only: logs whether the units are enabled at boot. The leading "-"
# means a missing script (an older release, after a rollback) cannot block start.
ExecStartPre=-@RELEASES_ROOT@/current/comfyui/zbrad/scripts/check_enabled.sh
ExecStart=@VENV@/bin/python main.py --listen ${COMFY_LISTEN_ADDR} --port ${COMFY_PORT} --extra-model-paths-config ${COMFY_EXTRA_MODEL_PATHS}
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
